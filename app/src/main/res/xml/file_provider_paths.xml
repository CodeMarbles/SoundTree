<?xml version="1.0" encoding="utf-8"?>
<!--
  file_provider_paths.xml
  ─────────────────────────────────────────────────────────────────────────────
  Defines the path roots that app.soundtree.fileprovider is authorised to
  expose via content:// URIs.

  Authority: app.soundtree.fileprovider
  Declared in: AndroidManifest.xml (<provider> inside <application>)

  ── Paths ────────────────────────────────────────────────────────────────────

  external-files-path  name="recordings"  path="."
    Maps Context.getExternalFilesDirs(null)[*] — the app-private directories
    on all mounted storage volumes (internal storage, SD card, etc.).
    Recording .m4a files live here under year/month subdirectories, e.g.:
      /sdcard/Android/data/app.soundtree/files/2026/06/ST_20260623_111213.m4a
    The "." path root allows sharing from any subdirectory under the app's
    external files root, accommodating the year/month layout and any future
    restructuring.

    Note: <external-files-path> covers ALL volumes returned by
    getExternalFilesDirs, not just primary storage. This means SD card
    recordings can be shared without any additional path configuration.

  cache-path  name="share_cache"  path="share/"
    Maps Context.getCacheDir()/share/ — the ephemeral staging directory used
    by ShareManager for:
      - Audio files renamed to the user's chosen filename before sharing
      - JSON metadata exports generated at share time

    Files here are pruned by ShareManager.pruneShareCache() (24-hour TTL)
    and are also cleared automatically when the OS reclaims cache space.
-->
<paths>

    <!--
        App-private external files on all mounted storage volumes.
        Covers: internal storage, SD card, and any future volumes.
        Recording .m4a files live here under year/month subdirectories.
    -->
    <external-files-path
        name="recordings"
        path="." />

    <!--
        Ephemeral share cache: renamed audio files and JSON exports.
        Only ShareManager writes here; files are short-lived.
    -->
    <cache-path
        name="share_cache"
        path="share/" />

</paths>