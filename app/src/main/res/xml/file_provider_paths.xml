<?xml version="1.0" encoding="utf-8"?>
<paths>

    <!--
        Primary (emulated) volume app-specific recordings.
        Resolves to getExternalFilesDirs()[0]/recordings, i.e.
        /storage/emulated/0/Android/data/app.soundtree/files/recordings.
        <external-files-path> covers ONLY the primary volume ([0]); secondary
        volumes need the root-path entry below.
    -->
    <external-files-path
        name="recordings_primary"
        path="recordings/" />

    <!--
        Secondary / removable volumes (SD cards).
        App-specific dirs on secondary volumes live at
        /storage/<volume-uuid>/Android/data/app.soundtree/files/..., which no
        external-* root reaches (all are anchored to the primary volume). The
        volume UUID is per-card and dynamic, so /storage/ is the narrowest
        stable root that spans them.

        Breadth note: this only defines which files are ELIGIBLE to be mapped to
        a content:// URI. ShareManager still mints one URI per file explicitly
        via getUriForFile() (only ever for recording.filePath values from Room),
        and grants are per-intent. It does not expose /storage to other apps.
    -->
    <root-path
        name="recordings_secondary"
        path="storage/" />

    <!--
        Ephemeral share cache: JSON metadata exports.
        Only ShareManager writes here; files are short-lived.
    -->
    <cache-path
        name="share_cache"
        path="share/" />

</paths>