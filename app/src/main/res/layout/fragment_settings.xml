<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_settings.xml
  Tabbed settings layout: Display · Behavior · Storage · Tools
  Root changes from ScrollView → LinearLayout so the tab bar is fixed at top
  and only the active tab's ScrollView scrolls. All existing view IDs are
  preserved so SettingsFragment.kt binding calls require no changes except
  the addition of setupTabs().
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground">

    <!-- ── Always-visible header ──────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="10dp">

        <!-- Icon + app name on the same row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvAppIdentity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:src="@mipmap/ic_launcher_n8tree_mark"
                android:contentDescription="@null" />

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_label_tagline"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── Tab bar ────────────────────────────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="?attr/colorSurfaceBase"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabDisplay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/settings_tab_display"
                android:textSize="12sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabBehavior"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/settings_tab_behavior"
                android:textSize="12sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabStorage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/settings_tab_storage"
                android:textSize="12sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabTools"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/settings_tab_tools"
                android:textSize="12sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Tab content (FrameLayout holds all 4 ScrollViews) ─────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ═══════════════════════════════════════════════════════════
             DISPLAY TAB  (landing tab — visible by default)
             Contains: Appearance, Waveform style, Layout, Widgets, App info
             ═══════════════════════════════════════════════════════════ -->
        <ScrollView
            android:id="@+id/scrollDisplay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorBackground"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ── APPEARANCE section ────────────────────────────── -->
                <include
                    android:id="@+id/groupAppearance"
                    layout="@layout/settings_group_appearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── WAVEFORM + LIBRARY DISPLAY sections ──────────────── -->
                <include
                    android:id="@+id/groupWaveform"
                    layout="@layout/settings_group_waveform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── RECORDING WIDGET + PLAYBACK WIDGET sections ──────── -->
                <include
                    android:id="@+id/groupWidgets"
                    layout="@layout/settings_group_widgets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════════
             BEHAVIOR TAB
             Contains: Navigation, Controls (scrub / mark)
             ═══════════════════════════════════════════════════════════ -->
        <ScrollView
            android:id="@+id/scrollBehavior"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ── STARTUP TAB PREFERENCE sections ───────────────────── -->
                <include
                    android:id="@+id/groupStartup"
                    layout="@layout/settings_group_startup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── NAVIGATION + CONTROLS sections ───────────────────── -->
                <include
                    android:id="@+id/groupNavigationControls"
                    layout="@layout/settings_group_navigation_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── PLAYBACK MEMORY section ───────────────────────────── -->
                <include
                    android:id="@+id/groupPlaybackMemory"
                    layout="@layout/settings_group_playback_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── FREQUENT TOPICS section ──────────────────────────── -->
                <include
                    android:id="@+id/groupTopicPicker"
                    layout="@layout/settings_group_topic_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </LinearLayout>

        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════════
             STORAGE TAB
             Contains: Volume selector, Recording recovery
             ═══════════════════════════════════════════════════════════ -->
        <ScrollView
            android:id="@+id/scrollStorage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ── STORAGE VOLUMES section ──────────────────────────── -->
                <include
                    android:id="@+id/groupStorageVolumes"
                    layout="@layout/settings_group_storage_volumes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── BACKUPS section ───────────────────────────────────── -->
                <include
                    android:id="@+id/groupBackups"
                    layout="@layout/settings_group_backups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── RESTORE section ───────────────────────────────────── -->
                <include
                    android:id="@+id/groupRestore"
                    layout="@layout/settings_group_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── RECORDING RECOVERY section ───────────────────────── -->
                <include
                    android:id="@+id/groupRecordingRecovery"
                    layout="@layout/settings_group_recording_recovery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════════
             TOOLS TAB
             Contains: Processing jobs (waveform regeneration), Dev options
             ═══════════════════════════════════════════════════════════ -->
        <ScrollView
            android:id="@+id/scrollTools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ── STATS section ─────────────────────────────────────── -->
                <include
                    android:id="@+id/groupStatsDisplay"
                    layout="@layout/settings_group_stats_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── PROCESSING JOBS section ───────────────────────────── -->
                <include
                    android:id="@+id/groupProcessingJobs"
                    layout="@layout/settings_group_processing_jobs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ═══════════════════════════════════════════════════════════
                     RECORDING MIGRATION section
                     Gated behind Future Mode — visibility set programmatically
                     in SettingsFragment.setupMigrationSection().
                     ═══════════════════════════════════════════════════════════ -->
                <include
                    android:id="@+id/groupMigration"
                    layout="@layout/settings_group_migration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ── MODE TOGGLES / DEV OPTIONS section ────────────────── -->
                <include
                    android:id="@+id/groupDevOptions"
                    layout="@layout/settings_group_dev_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</LinearLayout>