<?xml version="1.0" encoding="utf-8"?>
<!--
  One entry in the Frequent Topics section of TopicPickerBottomSheet.

  The outer LinearLayout is the single unified touch target — tapping anywhere
  on the entry (lineage strip or topic row) fires the selection. Only the
  chevron intercepts touch independently for expand/collapse.

  Structure (top → bottom, inside the touch target):
    lineageRow   — horizontal strip of 2/3-scale ancestor circles + arrows
                   GONE for root-level topics (no ancestors)
    topicRow     — icon · name · (score) · chevron at full picker scale
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frequentEntryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- ── Lineage strip ──────────────────────────────────────────── -->
    <!--
      Horizontally scrollable so a very deep ancestry never clips.
      Populated programmatically in bindFrequentEntry().
      Circles are ~15dp, text ~11sp (2/3 of the 22dp/16sp main scale).
    -->
    <HorizontalScrollView
        android:id="@+id/lineageScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/lineageStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="false"
            android:focusable="false" />

    </HorizontalScrollView>

    <!-- ── Topic row ─────────────────────────────────────────────── -->
    <!--
      Not clickable itself — the outer root handles the tap.
      The chevron is the one exception: it intercepts touch for expand/collapse.
    -->
    <LinearLayout
        android:id="@+id/topicRowInner"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/tvFrequentIcon"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvFrequentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tvFrequentScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="?attr/colorTextSecondary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivFrequentChevron"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_chevron_down"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="?attr/colorTextSecondary" />

    </LinearLayout>

</LinearLayout>