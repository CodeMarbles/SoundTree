<?xml version="1.0" encoding="utf-8"?>
<!--
  One entry in the Frequent Topics section of TopicPickerBottomSheet.

  The outer LinearLayout is the single unified touch target. The chevron
  intercepts touch independently for expand/collapse.

  Structure:
    contentRow  — horizontal: [FlowLayout (lineage + icon + name + score)] [chevron]
                  The FlowLayout wraps when lineage nodes overflow the available
                  width, so deep hierarchies with labels enabled never clip.

  The old two-row design (lineageRow above topicRow) is replaced by a single
  FlowLayout whose children are built programmatically in bindFrequentEntry():
    [ancestorIcon (+ label?)] [›] … [›] [topicIcon] [topicName]
  The chevron sits outside the FlowLayout so it always anchors to the right
  edge of the touch target regardless of how many rows the content wraps to.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frequentEntryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="44dp">

    <!-- ── Flow content: lineage nodes + topic icon + name + score ── -->
    <!--
      layout_weight=1 lets it take all space left of the chevron.
      Children are added programmatically; see buildFrequentEntryFlow().
    -->
    <app.soundtree.ui.common.FlowLayout
        android:id="@+id/flowLineageAndTopic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="false"
        android:focusable="false" />

    <!-- ── Score (dev only) ──────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvFrequentScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="?attr/colorTextSecondary"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <!-- ── Chevron: expand/collapse children ────────────────────── -->
    <!--
      Sits outside the FlowLayout so it always aligns to the top-right of
      the touch target even when the flow wraps to multiple lines.
      layout_gravity=top keeps it at the top of the cell when content wraps.
    -->
    <ImageView
        android:id="@+id/ivFrequentChevron"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:src="@drawable/ic_chevron_down"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:tint="?attr/colorTextSecondary" />

</LinearLayout>