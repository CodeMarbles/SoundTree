<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceBase">

    <!-- ── Title row ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/topic_picker_title_select"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAddTopic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/topic_picker_btn_add_topic"
            app:tint="?attr/colorAccent" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceElevated" />

    <!-- ── Frequent topics section ────────────────────────────────── -->
    <!--
      Visible only in Mode.PICK when at least one topic has a score above
      the minimum threshold. Toggled VISIBLE/GONE by TopicPickerBottomSheet.
      The inner LinearLayout is populated programmatically — one inflated
      item_frequent_topic view per FrequentTopic entry.
    -->
    <LinearLayout
        android:id="@+id/sectionFrequentTopics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFrequentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/topic_picker_frequent_label"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerFrequentTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceElevated"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ── Unsorted option ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowUnsorted"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvNullRowIcon"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="@string/topic_emoji_unsorted"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvNullRowLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/topic_label_unsorted"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginStart="10dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceElevated"
        android:layout_marginHorizontal="16dp" />

    <!-- ── Topic tree ─────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTopics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp"
        android:clipToPadding="false" />

</LinearLayout>