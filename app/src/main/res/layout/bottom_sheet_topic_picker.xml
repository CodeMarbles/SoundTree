<?xml version="1.0" encoding="utf-8"?>
<!--
  bottom_sheet_topic_picker.xml

  Layout: two zones.

  Zone 1 — FIXED header (never scrolls):
    Title row ("Select Topic" / "Move Topic" / "Choose Parent") + divider.

  Zone 2 — SCROLLABLE body (everything else moves together):
    NestedScrollView containing:
      • Frequent topics section (VISIBLE/GONE by TopicPickerBottomSheet)
      • Unsorted / Top-level null row
      • Divider
      • Topic tree RecyclerView (wrap_content + nestedScrollingEnabled=false
        so the NestedScrollView drives scrolling, not the RecyclerView itself)

  The BottomSheetDialog's own CoordinatorLayout/BottomSheetBehavior handles
  the drag-to-dismiss gesture on the sheet as a whole; NestedScrollView
  cooperates with it correctly via nested scroll dispatch.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceBase">

    <!-- ══ Zone 1: Fixed header ════════════════════════════════════ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/topic_picker_title_select"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAddTopic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/topic_picker_btn_add_topic"
            app:tint="?attr/colorAccent" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceElevated" />

    <!-- ══ Zone 2: Scrollable body ═════════════════════════════════ -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Frequent topics section ────────────────────────── -->
            <!--
              Visible only in Mode.PICK when at least one topic has a score
              above the minimum threshold. Toggled VISIBLE/GONE by
              TopicPickerBottomSheet. The inner LinearLayout is populated
              programmatically — one inflated item_frequent_topic view per
              FrequentTopic entry.
            -->
            <LinearLayout
                android:id="@+id/sectionFrequentTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFrequentLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/topic_picker_frequent_label"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp" />

                <LinearLayout
                    android:id="@+id/containerFrequentTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorSurfaceElevated"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- ── Unsorted / Top-level null row ─────────────────── -->
            <LinearLayout
                android:id="@+id/rowUnsorted"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvNullRowIcon"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="@string/topic_emoji_unsorted"
                    android:textSize="16sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvNullRowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/topic_label_unsorted"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="14sp"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorSurfaceElevated"
                android:layout_marginHorizontal="16dp" />

            <!-- ── Topic tree ─────────────────────────────────────── -->
            <!--
              nestedScrollingEnabled=false: the NestedScrollView above owns
              scrolling. The RecyclerView expands to its full wrap_content
              height and the outer scroll container moves everything together.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="32dp"
                android:clipToPadding="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>