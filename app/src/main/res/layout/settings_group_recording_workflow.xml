<?xml version="1.0" encoding="utf-8"?>
<!--
  settings_group_recording_workflow.xml
  New settings group for the Behavior tab.

  Include in fragment_settings.xml inside scrollBehavior's LinearLayout,
  after the existing groupTopicPicker include:

      <include
          android:id="@+id/groupRecordingWorkflow"
          layout="@layout/settings_group_recording_workflow"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />

  IDs surfaced via the include:
    switchQuickRecordDetailsSwap
    switchQuickRecordTopicsSwap
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ── RECORDING WORKFLOW section header ─────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_section_recording_workflow"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="?attr/colorSurfaceBase"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <!-- Quick record from Topic Details — swap to Record tab -->
            <LinearLayout
                android:id="@+id/rowQuickRecordDetailsSwap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_quick_record_details_swap"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_quick_record_details_swap_desc"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchQuickRecordDetailsSwap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorSurfaceElevated"
                android:layout_marginHorizontal="16dp" />

            <!-- Quick record from Topics menu — swap to Record tab -->
            <LinearLayout
                android:id="@+id/rowQuickRecordTopicsSwap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_quick_record_topics_swap"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_quick_record_topics_swap_desc"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchQuickRecordTopicsSwap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>