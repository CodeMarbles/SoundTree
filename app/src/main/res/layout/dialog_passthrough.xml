<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_passthrough.xml
  Bottom sheet layout for PassthroughDialogFragment.

  Structure (top → bottom):
    1. Drag handle
    2. Header row  — title + enabled SwitchCompat
    3. Divider
    4. Section label — "OUTPUT DEVICES"
    5. RecyclerView  — device rows (item_passthrough_device.xml)
    6. Divider
    7. Callout       — info note about disconnected devices

  The RecyclerView uses wrap_content height with nested scrolling disabled;
  the BottomSheetDialog's own scroll container handles sheet dragging.
  This keeps the layout simple and avoids nested-scroll conflicts.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceBase">

    <!-- ── Drag handle ───────────────────────────────────────────────────── -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_drag_handle_pill" />

    <!-- ── Header: title + enabled toggle ───────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/passthrough_dialog_title"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/passthrough_dialog_enabled_label"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchPassthroughEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- ── Volume ────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/passthrough_dialog_volume_label"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0.0"
            android:valueTo="1.0"
            android:contentDescription="@string/passthrough_dialog_volume_label" />

    </LinearLayout>

    <!-- ── Divider ───────────────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="?attr/colorSurfaceElevated" />

    <!-- ── Section label ─────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/passthrough_dialog_section_output"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08" />

    <!-- ── Device list ────────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPassthroughDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false" />

    <!-- ── Divider ───────────────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:background="?attr/colorSurfaceElevated" />

    <!-- ── Callout ────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_callout_rounded">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="ⓘ"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/passthrough_dialog_callout"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>

</LinearLayout>