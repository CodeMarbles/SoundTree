<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_restore_wizard.xml
  ─────────────────────────────────────────────────────────────────────────────
  Root layout for RestoreWizardDialogFragment.

  Structure:
    ┌─ LinearLayout (vertical, full width) ─────────────────────────────────┐
    │  Title bar                                                             │
    │  ┌─ ViewFlipper ──────────────────────────────────────────────────┐   │
    │  │  child[0]  Step 0 — Snapshot selection                         │   │
    │  │  child[1]  Step 1 — Library summary + safety notice            │   │
    │  │  child[2]  Step 2 — Destructive confirmation                   │   │
    │  │  child[3]  Step 3 — Progress                                   │   │
    │  └────────────────────────────────────────────────────────────────┘   │
    │  Navigation row  [ Back ]                    [ Next / Restore ]       │
    └────────────────────────────────────────────────────────────────────────┘
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title bar -->
    <TextView
        android:id="@+id/tvWizardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/restore_wizard_title"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_marginBottom="20dp" />

    <!-- Step container -->
    <ViewFlipper
        android:id="@+id/wizardFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateFirstView="false">

        <!-- ─────────────────────────────────────────────────────────────────
             Step 0 — Snapshot selection
             ───────────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="120dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step0_desc"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvSnapshotLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step0_scanning"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tvNoSnapshots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step0_none_found"
                android:textColor="#B3261E"
                android:visibility="gone" />

            <!-- Manifest summary — visible only when soundtree-backup.json is present -->
            <TextView
                android:id="@+id/tvManifestSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="260dp">

                <RadioGroup
                    android:id="@+id/rgSnapshots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- ─────────────────────────────────────────────────────────────────
             Step 1 — Library summary
             ───────────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="120dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step1_your_library"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvSummaryLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step1_loading"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="visible" />

            <!-- Count rows — hidden until loaded -->

            <TextView
                android:id="@+id/tvSummaryRecordings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSummaryMarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSummaryTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Safety notice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_rounded_surface"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_step1_safety_notice"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- ─────────────────────────────────────────────────────────────────
             Step 2 — Volume selection
             ───────────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="120dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step_volume_heading"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step_volume_desc"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="16dp" />

            <!-- Shown only while the volume list is being resolved -->
            <TextView
                android:id="@+id/tvVolumeLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step_volume_loading"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="visible" />

            <!-- Single-volume case: no radio buttons, just an info card -->
            <LinearLayout
                android:id="@+id/layoutSingleVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_surface"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSingleVolumeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <!-- Multi-volume case: scrollable radio group -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollVolumeRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="200dp"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/rgVolumes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </androidx.core.widget.NestedScrollView>

            <!-- Space warning — amber text, shown only when backup > free space -->
            <LinearLayout
                android:id="@+id/layoutSpaceWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_surface"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSpaceWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="#E65100"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

        </LinearLayout>

        <!-- ─────────────────────────────────────────────────────────────────
             Step 3 — Destructive confirmation
             ───────────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="120dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step2_heading"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#B3261E"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step2_body"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_step2_safety_note"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <!-- ─────────────────────────────────────────────────────────────────────
             Step 4 — Progress
             Uses match_parent + layout_weight="1" (set on wizardFlipper) so that
             the RecyclerView fills all available height and the nav buttons stay
             pinned at the bottom of the screen.
             ─────────────────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Phase label + progress bar ───────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_progress_starting"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/restoreProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvProgressSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <!-- Milestone board ───────────────────────────────────────────────────
                 Four static rows, one per major restore phase. Each row starts
                 PENDING (greyed dot) and resolves to ✓ / ✗ as the restore runs.
                 ─────────────────────────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/milestoneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="?attr/colorSurfaceBase">

                <include android:id="@+id/milestoneSafety"
                    layout="@layout/item_restore_milestone" />
                <include android:id="@+id/milestoneMetadata"
                    layout="@layout/item_restore_milestone" />
                <include android:id="@+id/milestoneDbSwap"
                    layout="@layout/item_restore_milestone" />
                <include android:id="@+id/milestonePathRemap"
                    layout="@layout/item_restore_milestone" />

            </LinearLayout>

            <!-- Filter chips ──────────────────────────────────────────────────────
                 Hidden until the first file section appears.
                 ─────────────────────────────────────────────────────────────────── -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:visibility="gone">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterAll"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterWrites"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Writes + failures" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterFails"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Failures only" />

            </com.google.android.material.chip.ChipGroup>

            <!-- File event log ────────────────────────────────────────────────────
                 layout_weight="1": expands to fill all remaining space so the
                 nav buttons are never pushed off screen by a long log.
                 ─────────────────────────────────────────────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProgressLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <!-- Error detail ──────────────────────────────────────────────────────
                 Shown only on RestorePhase.Error; sits below the log so the
                 milestone board and whatever ran before the failure remain visible.
                 ─────────────────────────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvProgressError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#B3261E"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />

        </LinearLayout>

    </ViewFlipper>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#CAC4D0" />

    <!-- Navigation buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wizard_btn_back"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardNext"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wizard_btn_next" />

    </LinearLayout>

</LinearLayout>